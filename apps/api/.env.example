# ======================
# Billing - Dodo Payments
# ======================
# Test mode key: https://test.dodopayments.com | Live mode: https://live.dodopayments.com
DODO_PAYMENTS_API_KEY=
# Signing secret from Developer -> Webhooks in the Dodo dashboard
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Only for local development when replaying unsigned mock events. Never enable in production.
DODO_PAYMENTS_SKIP_WEBHOOK_VERIFICATION=false
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/app/billing?checkout=success
DODO_PAYMENTS_CANCEL_URL=http://localhost:3000/app/billing?checkout=cancelled

# One subscription product per paid tier and interval.
DODO_PRODUCT_SOLO_MONTHLY=
DODO_PRODUCT_SOLO_YEARLY=
DODO_PRODUCT_CREATOR_PRO_MONTHLY=
DODO_PRODUCT_CREATOR_PRO_YEARLY=
