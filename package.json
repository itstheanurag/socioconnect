{
  "name": "socioconnect",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@repo/api",
    "dev:mcp": "turbo dev --filter=@repo/mcp",
    "dev:metrics": "turbo dev --filter=@repo/metrics",
    "build": "turbo build",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "lint": "turbo lint",
    "test": "bun test",
    "test:agent": "bun test apps/api/src/modules/api-keys apps/api/src/modules/oauth apps/api/src/modules/entitlements apps/api/src/modules/publish-intents/publish-intents.hash.test.ts apps/api/src/middlewares/api-key-scope.middleware.test.ts packages/shared/src/oauth-token.test.ts packages/shared/src/service-token.test.ts",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "turbo": "^2.7.0"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.9.30",
    "hono-rate-limiter": "^0.5.1",
    "mime-types": "^3.0.2"
  }
}
