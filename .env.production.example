# Production environment template.
# Copy to .env on the deployment host and fill every value.
# Never commit the filled file.

NODE_ENV=production
LOG_LEVEL=info

# Database (the compose stack overrides DATABASE_URL to point at the postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=socioconnect

# Security
# openssl rand -hex 32
ENCRYPTION_KEY=
# openssl rand -base64 48
JWT_SECRET=
SERVICE_TOKEN_SECRET=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# Domains
FRONTEND_URL=https://socioconnect.app
CORS_ORIGIN=https://socioconnect.app
NEXT_PUBLIC_API_URL=https://api.socioconnect.app
NEXT_PUBLIC_MCP_URL=https://mcp.socioconnect.app/mcp
OAUTH_ISSUER=https://api.socioconnect.app
API_RESOURCE_URL=https://api.socioconnect.app
MCP_RESOURCE_URL=https://mcp.socioconnect.app/mcp
APP_BASE_URL=https://socioconnect.app

# Caddy
ACME_EMAIL=ops@socioconnect.app
WEB_DOMAIN=socioconnect.app
API_DOMAIN=api.socioconnect.app
MCP_DOMAIN=mcp.socioconnect.app

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.socioconnect.app/v1/oauth/google/callback

# Billing (Dodo Payments is the merchant of record)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_SKIP_WEBHOOK_VERIFICATION=false
DODO_PAYMENTS_RETURN_URL=https://socioconnect.app/dashboard?checkout=success
DODO_PAYMENTS_CANCEL_URL=https://socioconnect.app/dashboard?checkout=cancelled

DODO_PRODUCT_SOLO_MONTHLY=
DODO_PRODUCT_SOLO_YEARLY=
DODO_PRODUCT_CREATOR_PRO_MONTHLY=
DODO_PRODUCT_CREATOR_PRO_YEARLY=
DODO_PRODUCT_STUDIO_MONTHLY=
DODO_PRODUCT_STUDIO_YEARLY=
DODO_PRODUCT_AGENCY_MONTHLY=
DODO_PRODUCT_AGENCY_YEARLY=

# Social providers (configure the ones you enable)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
BLUESKY_PDS_URL=https://bsky.social
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=https://api.socioconnect.app

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=socioconnect-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://cdn.socioconnect.app
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto

# Marketplace review account
DEMO_LOGIN_ENABLED=true
DEMO_ACCOUNT_EMAIL=review@socioconnect.app
DEMO_ACCOUNT_PASSWORD=replace-with-a-strong-password
DEMO_ACCOUNT_NAME=Review Workspace
OPENAI_APPS_CHALLENGE_TOKEN=

# Internal MCP wiring (compose sets these too)
MCP_PORT=8010
API_BASE_URL=http://api:8000
