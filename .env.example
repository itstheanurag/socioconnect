# ======================
# Server Configuration
# ======================
PORT=8000
NODE_ENV=development
LOG_LEVEL=info
# Optional: ship logs to Grafana Loki (docker-compose.dev). Leave empty to disable.
LOKI_HOST=

# ======================
# Database
# ======================
DATABASE_URL=postgresql://postgres:postgres@localhost:${POSTGRES_PORT:-5432}/backend-template

# ======================
# OAuth - Google
# ======================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/oauth/google/callback

# ======================
# Social Publishing Providers (configure providers you enable)
# ======================
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

THREADS_APP_ID=
THREADS_APP_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

BLUESKY_PDS_URL=https://bsky.social

DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Telegram bot tokens are provided per connected account. Optional defaults:
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_BASE_URL=https://api.example.com

# ======================
# OAuth - Apple
# ======================
APPLE_CLIENT_ID=your-apple-services-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_REDIRECT_URI=http://localhost:8000/v1/oauth/apple/callback
# Note: Apple rejects localhost as a Services ID domain. For local dev, use ngrok
# (or similar) and set APPLE_REDIRECT_URI to your public HTTPS tunnel URL.

# ======================
# Security
# ======================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-chars

# ======================
# CORS & Web Client
# ======================
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ======================
# Docker Service Ports
# ======================
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=8001
LOKI_PORT=3100
METRICS_SERVER_PORT=3002

# ======================
# Billing - Dodo Payments
# ======================
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_SKIP_WEBHOOK_VERIFICATION=false
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/dashboard?checkout=success
DODO_PAYMENTS_CANCEL_URL=http://localhost:3000/dashboard?checkout=cancelled

DODO_PRODUCT_SOLO_MONTHLY=
DODO_PRODUCT_SOLO_YEARLY=
DODO_PRODUCT_CREATOR_PRO_MONTHLY=
DODO_PRODUCT_CREATOR_PRO_YEARLY=
DODO_PRODUCT_STUDIO_MONTHLY=
DODO_PRODUCT_STUDIO_YEARLY=
DODO_PRODUCT_AGENCY_MONTHLY=
DODO_PRODUCT_AGENCY_YEARLY=

# ======================
# OAuth 2.1 / MCP
# ======================
OAUTH_ISSUER=http://localhost:8000
MCP_RESOURCE_URL=http://localhost:8010/mcp
API_RESOURCE_URL=http://localhost:8000
# Defaults to JWT_SECRET when empty
SERVICE_TOKEN_SECRET=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# MCP app (apps/mcp loads this file)
MCP_PORT=8010
API_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3000

# ======================
# Marketplace review demo login
# ======================
DEMO_LOGIN_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo@socioconnect.app
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_NAME=Demo Creator

# OpenAI plugin domain verification token
OPENAI_APPS_CHALLENGE_TOKEN=

# ======================
# Cloudflare R2 media storage
# ======================
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=socioconnect-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://cdn.socioconnect.app
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
